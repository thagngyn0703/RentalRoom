[Unit]
Description=RentalRoom Express backend
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=codexproxy
Group=codexproxy
WorkingDirectory=/home/codexproxy/Codex-thangtts/RentalRoom/.worktrees/public-ip-production/backend
EnvironmentFile=/etc/rentalroom/backend.env
ExecStart=/usr/bin/node server.js
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
KillSignal=SIGTERM
TimeoutStopSec=20

[Install]
WantedBy=multi-user.target
